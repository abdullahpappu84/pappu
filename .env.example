# ================= Required =================
DATABASE_URL=postgresql://user:password@host:5432/aurum
AUTH_SECRET=change-me-to-64-random-characters
APP_URL=https://www.yourcasino.com
ADMIN_EMAIL=admin@yourcasino.com
ADMIN_PASSWORD=ChangeMe-Str0ng!

# ================= Payment gateways =================
# A gateway appears on the Deposit page automatically once its keys are set (restart required).
# {GATEWAY}_CURRENCY / {GATEWAY}_EXCHANGE_RATE: 1 unit of site currency = N units of gateway currency.

# --- Stripe (cards, Apple/Google Pay) — webhook: https://YOUR-DOMAIN/api/payments/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=
STRIPE_EXCHANGE_RATE=

# --- SSLCommerz (BD cards, bKash, Nagad, Rocket) — IPN sent automatically
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
SSLCOMMERZ_CURRENCY=BDT
SSLCOMMERZ_EXCHANGE_RATE=

# --- bKash Tokenized Checkout — callback sent automatically
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_SANDBOX=true
BKASH_EXCHANGE_RATE=

# --- NOWPayments (crypto) — IPN sent automatically
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false
NOWPAYMENTS_CURRENCY=
NOWPAYMENTS_EXCHANGE_RATE=

# --- Custom / generic gateway — webhook: https://YOUR-DOMAIN/api/payments/webhook/custom
CUSTOM_GATEWAY_NAME=
CUSTOM_GATEWAY_CREATE_URL=
CUSTOM_GATEWAY_API_KEY=
CUSTOM_GATEWAY_WEBHOOK_SECRET=
CUSTOM_GATEWAY_SIGNATURE_HEADER=x-signature
CUSTOM_GATEWAY_CURRENCY=
CUSTOM_GATEWAY_EXCHANGE_RATE=

# ================= Game provider / aggregator =================
GAME_DEFAULT_ADAPTER=aggregator
GAME_API_URL=
GAME_API_KEY=
GAME_API_SECRET=
GAME_OPERATOR_ID=
GAME_LAUNCH_PATH=/games/launch
GAME_DEMO_PATH=/games/demo
GAME_DEFAULT_CURRENCY=EUR
GAME_DISPLAY=iframe
GAME_CALLBACK_SECRET=
GAME_SIGNATURE_HEADER=x-signature
GAME_CALLBACK_IPS=

# ================= Optional =================
EXPOSE_DEV_TOKENS=false
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
STORAGE_DIR=
